{
  "name": "tm-toolset",
  "version": "0.69.6",
  "description": "TM Toolset — technician diagnostic suite by Technical Merritt Computer Services.",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.technicalmerit.tmtoolset",
    "productName": "TM Toolset",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/scanner/**",
      "**/drives/**",
      "**/crash/**",
      "**/battery/**",
      "**/devices/**",
      "**/startup/**",
      "**/inform/**",
      "**/repairs/**",
      "**/disktools/**",
      "**/backup/**",
      "**/drivers/**",
      "**/net/**",
      "**/bios/**",
      "**/diagnose/**",
      "**/debloat/**",
      "**/boardrepair/**",
      "**/tools/**",
      "**/m365/**"
    ],
    "win": {
      "icon": "src/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
